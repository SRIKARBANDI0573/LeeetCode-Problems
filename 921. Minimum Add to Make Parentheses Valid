class Solution {
    public int minAddToMakeValid(String s) {
        int add = 0;
        int cnt = 0;
        for(char ch : s.toCharArray()){
            if(ch == '('){
                cnt++;
            }
            else{
                if(cnt > 0){
                    cnt--;
                }
                else{
                    add++;
                }
            }
        }
        int res = cnt + add;
        return res;
    }
}
