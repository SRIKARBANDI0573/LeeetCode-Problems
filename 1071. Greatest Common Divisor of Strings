class Solution {
    public String gcdOfStrings(String str1, String str2) {
        int s1 = str1.length();
        int s2 = str2.length();

        if(!(str1 + str2).equals(str2 + str1)){
            return "";
        }
        int res = gcd(s1 , s2);
        return str1.substring(0,res);
    }
            public static int gcd(int s1, int s2){
            while(s2 != 0){
                int temp = s2;
                s2 = s1 % s2;
                s1= temp;
            }
            return s1;
        }
}
