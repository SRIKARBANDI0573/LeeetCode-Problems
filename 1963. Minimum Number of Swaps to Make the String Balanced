class Solution {
    public int minSwaps(String s) {
        int bal = 0;
        int imbal = 0;

        for(char ch : s.toCharArray()){
            if(ch == '['){
                bal++;
            }
            else{
                bal--;

                if(bal < 0){
                    imbal++;
                    bal = 0;
                }
            }
        }
        int res = (imbal + 1) / 2;
        return res;
    }
}
