class Solution {
    public boolean uniqueOccurrences(int[] arr) {
        HashMap<Integer,Integer> hm = new HashMap<>();
        for(int nums:arr){
            hm.put(nums,hm.getOrDefault(nums,0) + 1);
        }

        HashSet<Integer> hs = new HashSet<>();
        for(int c : hm.values()){
            if(hs.contains(c)){
                return false;
            }
            hs.add(c);
        }
        return true;
    }
}
