class Solution {
    public long maxAlternatingSum(int[] nums) {
        int n = nums.length;
        long a[] = new long[n];
        for(int i = 0; i < n; i++){
            a[i] = nums[i] * nums[i];
        }
        Arrays.sort(a);
        int k = n / 2;
        long res = 0;
        for(int i = 0; i < k; i++){
            res = res - a[i];
        }
        for(int i = k; i < n; i++){
            res = res + a[i];
        }
        return res;
    }
}
